{
    "name": "llflash-web",
    "version": "1.0.0",
    "description": "Root project of web",
    "license": "(MIT OR Apache-2.0)",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "config": {
        "detect_chromedriver_version": true
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@wdio/browserstack-service": "^9.27.1",
        "@wdio/cli": "^9.27.1",
        "@wdio/local-runner": "^9.27.1",
        "@wdio/mocha-framework": "^9.27.1",
        "@wdio/spec-reporter": "^9.27.1",
        "@wdio/static-server-service": "^9.27.1",
        "chai": "^6.2.2",
        "chai-html": "^3.2.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "mocha": "^11.7.5",
        "prettier": "^3.8.3",
        "stylelint": "^17.11.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-prettier": "^5.0.3",
        "ts-loader": "^9.5.7",
        "tsx": "^4.21.0",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.3",
        "webdriverio": "^9.27.1",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2",
        "workspace-version": "^0.1.4"
    },
    "scripts": {
        "build": "pnpm --filter llflash-core build && pnpm --filter llflash-demo --filter llflash-extension --filter llflash-selfhosted build",
        "build:debug": "cross-env NODE_ENV=development CARGO_FEATURES=avm_debug pnpm build",
        "build:dual-wasm": "cross-env BUILD_WASM_MVP=true pnpm build",
        "build:repro": "cross-env ENABLE_VERSION_SEAL=true pnpm build",
        "build:dual-wasm-repro": "cross-env BUILD_WASM_MVP=true ENABLE_VERSION_SEAL=true pnpm build",
        "demo": "pnpm --filter llflash-demo preview",
        "test": "pnpm -r --if-present test",
        "wdio": "pnpm -r --if-present wdio",
        "docs": "pnpm -r --if-present docs",
        "lint": "pnpm -r --if-present checkTypes && eslint . && stylelint **.css",
        "format": "eslint . --fix && stylelint --fix **.css",
        "version-seal": "cross-env ENABLE_VERSION_SEAL=true tsx packages/core/tools/set_version.ts"
    }
}
